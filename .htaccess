Options -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Supprimer l'extension .html des URLs
# 0. Rediriger /index et /index.html → / (page d'accueil)
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 1. Rediriger /page.html → /page (301 permanent)
RewriteCond %{THE_REQUEST} \s/+([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2. Servir /page → /page.html en interne
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Cache des fonts et assets statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/html               "access plus 1 day"
</IfModule>

# ETag (désactiver pour éviter les conflits multi-serveurs)
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

# Compression gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript font/woff2 image/svg+xml
</IfModule>

# Keep-Alive
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>
